# Personal sandbox only. Never commit .env or paste secrets into a chat.
DATABASE_URL=postgresql+psycopg://gostdoc@127.0.0.1:55432/gostdoc_proto
PROTOTYPE_KEY=GENERATE_LOCALLY_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENV=development
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Explicit alternative, no automatic paid fallback. Key remains backend-only.
AI_PROVIDER=groq
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional, only if supported by the selected fixed model: none|minimal|low|medium|high
OPENROUTER_REASONING_EFFORT=
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
RETURN_URL=http://127.0.0.1:5173/
ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
STORAGE=disk
DATA_DIR=.local/private
DAILY_TOKENS=160000
TPM=7000
JOB_BUDGET=24000
MAX_DOCS=20

# Optional local owner simulation; never a qualifying referral cash purchase.
MOCK_PAYMENTS=false
AI_MAX_ATTEMPTS=5

# Private development only: simulated email verification, no outgoing mail
MOCK_EMAIL=false
