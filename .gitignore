# ==========================================
# Git Ignore Configuration for AI GostDoc
# ==========================================

# Markdown & internal task/instruction files (prevent leak to repo)
*.md
**/*.md
docs/*.md
brain/
instruction

# Environment files
.env
.env.*
!.env.example

# Node / Frontend dependencies & build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
.cache/
.antigravity/
.gemini/

# Python virtual environments & bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
coverage.xml
*.cover

# Database & SQLite files
*.db
*.sqlite
*.sqlite3
test.db

# Celery, Redis & logs
*.log
celerybeat-schedule
celerybeat.pid
*.pid

# Uploaded & generated user files (.docx, .pdf, temporary files)
uploads/*
!uploads/.gitkeep
*.docx
!samples/**/*.docx
temp/
tmp/

# IDE, OS & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
