  "components": {
    "schemas": {
      "Buy": {
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bonus"
            ],
            "title": "Method"
          },
          "approval_hash": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Approval Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "method",
          "approval_hash"
        ],
        "title": "Buy"
      },
      "Chapter": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Title"
          },
          "sections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Sections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "sections"
        ],
        "title": "Chapter"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Draft": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 400,
            "minLength": 8,
            "title": "Topic"
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "abstract",
              "coursework",
              "vkr"
            ],
            "title": "Doc Type",
            "default": "abstract"
          },
          "anonymized": {
            "type": "boolean",
            "const": true,
            "title": "Anonymized"
          },
          "pages": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Pages",
            "default": 10
          },
          "chapters": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 2.0,
            "title": "Chapters",
            "default": 2
          },
          "subject": {
            "type": "string",
            "maxLength": 200,
            "title": "Subject",
            "default": ""
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "title": "Notes",
            "default": ""
          },
          "input_version": {
            "type": "string",
            "title": "Input Version",
            "default": "personal-2026-11-v2"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic",
          "anonymized"
        ],
        "title": "Draft"
      },
      "EmailInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "EmailInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Plan": {
        "properties": {
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/Chapter"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 2,
            "title": "Chapters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chapters"
        ],
        "title": "Plan"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "referral_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Referral Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Register"
      },
      "Reset": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 20,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "Reset"
      },
      "TokenInput": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 20,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "TokenInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
